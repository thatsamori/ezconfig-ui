# /etc/systemd/system/ezconfig-platform.service, installed by provision.sh.
# Runs the current release (release.sh switches the link) as exactly one
# process, and restarts it whenever it exits. Startup migrates the database
# before serving.
[Unit]
Description=EZConfig platform (Next.js on Bun)
After=network-online.target
Wants=network-online.target
# Keep restarting however often it exits.
StartLimitIntervalSec=0
# Until the first deploy there is nothing to run.
ConditionPathExists=/srv/ezconfig-platform/current

[Service]
Type=simple
User=ezconfig
Group=ezconfig
WorkingDirectory=/srv/ezconfig-platform/current
# The one instance env file (.env.example lists its settings): root:root 0600,
# read by systemd before it switches to User=.
EnvironmentFile=/etc/ezconfig-platform/platform.env
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
# On loopback only: Caddy is the way in, and Litestream's heartbeat calls it here.
# `next start` from Next's own entry file: `bun --bun next start` would look up
# the `next` bin and run it as a child process, two processes instead of one.
ExecStart=/usr/local/bin/bun --bun node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=2
# A restart drops held polls; game servers poll again after about 10 s.
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
