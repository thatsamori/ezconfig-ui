# RCON info for your mordhau server instance
RCON_HOST=localhost
RCON_PORT=27015
RCON_PASSWORD=change_me

# This password is also stored in your servers Game.ini - to make sure the game mod is communicating with the correct server
EZCONFIG_PASSWORD=change_me

# Display name shown when reviewing an apply
NEXT_PUBLIC_SERVER_NAME=Mordhau server
SERVER_NAME=Mordhau server

# Opt in only on the one authoritative long-lived UI instance.
RCON_AUTO_SYNC_ENABLED=false
# Optional local ownership port; all instances for a target must agree.
# RCON_AUTO_SYNC_OWNER_PORT=4748

# Local storage locations (defaults shown; relative to the app directory)
DATABASES_PATH=./Databases
PRESETS_PATH=./Presets

# The platform's SQLite database file. Server owners and their sessions live
# here, so signing in needs it. Opened with bun:sqlite, so the app runs on Bun
# (bun --bun run dev, bun --bun next start). Startup applies migrations before
# serving and keeps copies beside it.
DATABASE_PATH=./platform.db

# Sign in with Discord
# The address browsers use: requests that change data must come from its
# origin. The session cookie is Secure, which browsers accept on http://localhost.
PUBLIC_URL=http://localhost:3000
# A Discord application (https://discord.com/developers/applications), OAuth2
# page: its client id and client secret. Add the redirect URL below to its
# Redirects. Sign-in asks Discord only for the identify scope.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults to PUBLIC_URL + /api/auth/discord/callback
# DISCORD_REDIRECT_URL=http://localhost:3000/api/auth/discord/callback
# Platform operators: comma-separated Discord user ids (Discord Settings >
# Advanced > Developer Mode, then right-click your name > Copy User ID). They
# sign in without an Invite; anyone else is refused as invite-only.
OPERATOR_DISCORD_IDS=

# Optional: separate Next build directory for an isolated preview
# while another dev server is running (default .next)
# NEXT_BUILD_DIR=.next-preview

# Hosted platform instance (docs/hosting.md). On the instance, the app's
# settings in this file live in /etc/ezconfig-platform/platform.env (root-only,
# loaded by ezconfig-platform.service), with
# DATABASE_PATH=/var/lib/ezconfig-platform/platform.db. The master copy of every
# instance setting is in the owner's password manager, never in the repo.
# Caddy reads these from /etc/ezconfig-platform/caddy.env. PUBLIC_HOSTNAME is
# PUBLIC_URL's host; PLATFORM_HOSTNAME is the URL built into the mod.
# PUBLIC_HOSTNAME=example.com
# PLATFORM_HOSTNAME=platform.example.com
# ACME_EMAIL=owner@example.com
# Litestream's bucket and its key live in /etc/litestream.yml (template:
# deploy/litestream.yml.example), not in an env file.
